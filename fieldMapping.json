        {
          "MapForActions": [
            "Create",
            "Update"
          ],
          "MappingMode": "Complex",
          "Value": "\"function getValue() {\\r\\n    let gender = 'U';\\r\\n    if (Person.details.gender != null)\\r\\n    {\\r\\n        if((Person.details.gender.toUpperCase() == 'MAN') | (Person.details.gender.toUpperCase() == 'MALE')) \\r\\n        {\\r\\n            gender = 'M'\\r\\n        }\\r\\n        if ((Person.details.gender.toUpperCase() == 'VROUW') | (Person.details.gender.toUpperCase() == 'FEMALE')) \\r\\n        {\\r\\n            gender = 'F' \\r\\n        }\\r\\n    } \\r\\n    return gender ;\\r\\n}\\r\\n\\r\\ngetValue()\"",
